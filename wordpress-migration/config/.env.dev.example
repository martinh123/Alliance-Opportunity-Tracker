# Development-only example. This file contains no working credentials.
# The original Express application uses DATABASE_URL, not the POSTGRES_* parts,
# but the split values below are included for a WordPress/SiteGround migration.

# PostgreSQL connection placeholders requested for the migration
POSTGRES_HOST=postgres.example.invalid
POSTGRES_PORT=5432
POSTGRES_DB=alliance_tracker_dev
POSTGRES_USER=REPLACE_ME
POSTGRES_PASSWORD=REPLACE_ME

# Original Express/Drizzle connection variable (leave blank; do not commit a URL)
DATABASE_URL=

# Geocoding. The original source calls Nominatim/OpenStreetMap directly and has
# no GEO_API_KEY. Keep the key blank if swapping to a provider that requires one.
GEO_API_PROVIDER=nominatim
GEO_API_KEY=

# AI. The source uses Gemini through Replit's managed integration, not OpenAI
# or Anthropic directly. Keep all key values blank in repository files.
AI_PROVIDER=gemini
AI_API_KEY=
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=

# Express/Vite runtime names used by the original source
NODE_ENV=development
PORT=8080
BASE_PATH=/
LOG_LEVEL=info
SESSION_SECRET=

# Replit/Expo development names used by the original workspace; these are not
# required by the WordPress runtime and should remain blank outside Replit.
REPLIT_DEV_DOMAIN=
REPLIT_EXPO_DEV_DOMAIN=
REPLIT_INTERNAL_APP_DOMAIN=
REPL_ID=
EXPO_PUBLIC_DOMAIN=
EXPO_PUBLIC_REPL_ID=